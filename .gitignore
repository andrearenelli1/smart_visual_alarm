# ESP-IDF build artifacts
build/
managed_components/

# sdkconfig contains WiFi credentials and local IP — never commit it
sdkconfig
sdkconfig.old

# Dataset caches (~60 GB total — download with model/download_coco.sh)
test/coco_cache/

# Hardware session logs (generated at runtime by alarm_backend / live_score_plot)
test/hardware_log/*.csv
test/hardware_log/live_score_*.png

# Model training — heavy artifacts (download with model/download_coco.sh)
model/coco_data/
model/checkpoints/
model/logs/
model/test_dataset/
model/output/plots/

# Evaluation output (generated by compare_models.py)
test/results/comparison/
test/results/*.npz
test/results/*.json
test/*.npz

# Python environments and caches
**/__pycache__/
**/.venv*/
*.pyc
*.pyo

# LaTeX build artifacts
*.log
*.aux
*.out
*.toc
*.synctex.gz

# Editor
.vscode/
